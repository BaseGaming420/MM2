local AutoFarm={}
AutoFarm.__index=AutoFarm

function AutoFarm.New(p)
    return setmetatable({
        Player=p,
        BagFull=false,
        RoundActive=false,
        IsElite=false,
        BagCap=40,
        CurrentTween=nil,
        Respawning=false,
        DiedThisRound=false
    },AutoFarm)
end

local function Char(self)return self.Player.Character end
local function HRP(self)local c=Char(self)return c and c:FindFirstChild("HumanoidRootPart")end
local function Hum(self)local c=Char(self)return c and c:FindFirstChildWhichIsA("Humanoid")end

function AutoFarm:CancelTween()
    if self.CurrentTween then self.CurrentTween:Cancel() self.CurrentTween=nil end
end

function AutoFarm:Reset()
    if self.Respawning then return end
    self.Respawning=true
    self.BagFull=false
    self.DiedThisRound=true
    self:CancelTween()
    local h=Hum(self)
    if h then h:ChangeState(Enum.HumanoidStateType.Dead) else local c=Char(self)if c then c:BreakJoints()end end
    task.spawn(function()
        local new=self.Player.CharacterAdded:Wait()
        if new then self.Respawning=false updateBagStatus(false) end
    end)
end

function AutoFarm:DetectCoins()
    Gameplay.CoinCollected.OnClientEvent:Connect(function(t,cur,cap)
        if t~="Coin"or type(cur)~="number"or type(cap)~="number"then return end
        if self.BagCap~=cap then self.BagCap=cap self.IsElite=cap>40 end
        if not self.RoundActive or self.BagFull or self.Respawning or self.DiedThisRound then return end
        if cur>=cap then
            self.BagFull=true
            updateBagStatus(true)
            if Settings.ResetOnBagFull and Settings.Enabled then
                if allAccountsFull() then self:Reset() end
            end
        end
    end)
end

function AutoFarm:DetectRounds()
    local CRC=require(RS.Modules.CurrentRoundClient)
    local d=CRC.PlayerData and CRC.PlayerData[self.Player.Name]
    if d then self.RoundActive=true self.DiedThisRound=d.Dead==true end

    Gameplay.RoundStart.OnClientEvent:Connect(function()
        self.RoundActive=true
        self.BagFull=false
        self.Respawning=false
        self.DiedThisRound=false
        updateBagStatus(false)
    end)

    Gameplay.VictoryScreen.OnClientEvent:Connect(function()
        self.RoundActive=false
        self.BagFull=false
        self:CancelTween()
        updateBagStatus(false)
    end)

    Gameplay.RoundEndFade.OnClientEvent:Connect(function()
        if self.RoundActive then
            self.RoundActive=false
            self.BagFull=false
            self:CancelTween()
            updateBagStatus(false)
        end
    end)

    CRC.PlayerDataChanged.Event:Connect(function()
        local d2=CRC.GetLatestPlayerData()
        local empty=true
        for _ in pairs(d2)do empty=false break end
        if empty then
            self.RoundActive=false
            self.BagFull=false
            self:CancelTween()
            updateBagStatus(false)
        end
    end)
end

function AutoFarm:GetNearestCoin()
    local r=HRP(self)
    if not r then return nil end
    local closest,dist=nil,math.huge
    for _,o in pairs(workspace:GetChildren())do
        local c=o:FindFirstChild("CoinContainer")
        if c then
            for _,coin in pairs(c:GetChildren())do
                if coin:GetAttribute("CoinID")=="Coin"and coin:FindFirstChild("TouchInterest")then
                    local d=(r.Position-coin.Position).Magnitude
                    if d<dist then closest=coin dist=d end
                end
            end
        end
    end
    return closest,dist
end

function AutoFarm:TweenTo(cf,dist)
    local r=HRP(self)
    local h=Hum(self)
    if not r or not h then return end
    self:CancelTween()
    local target=CFrame.new(cf.Position.X,cf.Position.Y+h.HipHeight,cf.Position.Z)
    local tw=game:GetService("TweenService"):Create(r,TweenInfo.new(dist/Settings.Speed,Enum.EasingStyle.Linear),{CFrame=target})
    self.CurrentTween=tw
    tw:Play()
end

function AutoFarm:Start()
    task.spawn(function()
        while true do
            task.wait()
            if not Settings.Enabled or not self.RoundActive or self.BagFull or self.Respawning or self.DiedThisRound then continue end
            local r=HRP(self)
            if not r then continue end
            local coin,dist=self:GetNearestCoin()
            if coin then
                if dist>150 then
                    r.CFrame=coin.CFrame
                else
                    self:TweenTo(coin.CFrame,dist)
                    repeat task.wait() until not coin:FindFirstChild("TouchInterest")or not self.RoundActive or self.BagFull or self.Respawning or self.DiedThisRound
                    self:CancelTween()
                end
            else
                task.wait(0.3)
            end
        end
    end)
end

