local AutoFarm = {}
AutoFarm.__index = AutoFarm

function AutoFarm.New(plr)
    return setmetatable({
        Player = plr,
        BagFull = false,
        RoundActive = false,
        IsElite = false,
        BagCap = 40,
        CurrentTween = nil,
        Respawning = false,
        DiedThisRound = false
    }, AutoFarm)
end

local function Char(self)
    return self.Player.Character
end

local function HRP(self)
    local c = Char(self)
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Hum(self)
    local c = Char(self)
    return c and c:FindFirstChildWhichIsA("Humanoid")
end

function AutoFarm:CancelTween()
    if self.CurrentTween then
        self.CurrentTween:Cancel()
        self.CurrentTween = nil
    end
end

function AutoFarm:Reset()
    if self.Respawning then return end
    self.Respawning = true
    self.BagFull = false
    self.DiedThisRound = true
    self:CancelTween()

    local h = Hum(self)
    if h then
        h:ChangeState(Enum.HumanoidStateType.Dead)
    else
        local c = Char(self)
        if c then c:BreakJoints() end
    end

    task.spawn(function()
        local newChar = self.Player.CharacterAdded:Wait()
        if newChar then
            self.Respawning = false
            updateBagStatus(false)
        end
    end)
end

function AutoFarm:DetectCoins()
    Gameplay.CoinCollected.OnClientEvent:Connect(function(t, cur, cap)
        if t ~= "Coin" or type(cur) ~= "number" or type(cap) ~= "number" then return end

        if self.BagCap ~= cap then
            self.BagCap = cap
            self.IsElite = cap > 40
        end

        if not self.RoundActive or self.BagFull or self.Respawning or self.DiedThisRound then
            return
        end

        if cur >= cap then
            self.BagFull = true
            updateBagStatus(true)

            if Settings.ResetOnBagFull and Settings.Enabled then
                if allAccountsFull() then
                    self:Reset()
                end
            end
        end
    end)
end

function AutoFarm:DetectRounds()
    local CRC = require(RS.Modules.CurrentRoundClient)

    local MyData = CRC.PlayerData and CRC.PlayerData[self.Player.Name]
    if MyData then
        self.RoundActive = true
        self.DiedThisRound = MyData.Dead == true
    end

    Gameplay.RoundStart.OnClientEvent:Connect(function()
        self.RoundActive = true
        self.BagFull = false
        self.Respawning = false
        self.DiedThisRound = false
        updateBagStatus(false)
    end)

    Gameplay.VictoryScreen.OnClientEvent:Connect(function()
        self.RoundActive = false
        self.BagFull = false
        self:CancelTween()
        updateBagStatus(false)
    end)

    Gameplay.RoundEndFade.OnClientEvent:Connect(function()
        if self.RoundActive then
            self.RoundActive = false
            self.BagFull = false
            self:CancelTween()
            updateBagStatus(false)
        end
    end)

    CRC.PlayerDataChanged.Event:Connect(function()
        local Data = CRC.GetLatestPlayerData()
        local isEmpty = true
        for _ in pairs(Data) do
            isEmpty = false
            break
        end

        if isEmpty then
            self.RoundActive = false
            self.BagFull = false
            self:CancelTween()
            updateBagStatus(false)
        end
    end)
end

function AutoFarm:GetNearestCoin()
    local root = HRP(self)
    if not root then return nil end

    local closest, dist = nil, math.huge

    for _, obj in pairs(workspace:GetChildren()) do
        local cont = obj:FindFirstChild("CoinContainer")
        if cont then
            for _, coin in pairs(cont:GetChildren()) do
                if coin:GetAttribute("CoinID") == "Coin"
                and coin:FindFirstChild("TouchInterest") then

                    local d = (root.Position - coin.Position).Magnitude
                    if d < dist then
                        closest = coin
                        dist = d
                    end
                end
            end
        end
    end

    return closest, dist
end

function AutoFarm:TweenTo(cf, dist)
    local root = HRP(self)
    local hum = Hum(self)
    if not root or not hum then return end

    self:CancelTween()

    local target = CFrame.new(
        cf.Position.X,
        cf.Position.Y + hum.HipHeight,
        cf.Position.Z
    )

    local tween = game:GetService("TweenService"):Create(
        root,
        TweenInfo.new(dist / Settings.Speed, Enum.EasingStyle.Linear),
        { CFrame = target }
    )

    self.CurrentTween = tween
    tween:Play()
end

function AutoFarm:Start()
    task.spawn(function()
        while true do
            task.wait()

            if not Settings.Enabled
            or not self.RoundActive
            or self.BagFull
            or self.Respawning
            or self.DiedThisRound then
                continue
            end

            local root = HRP(self)
            if not root then continue end

            local coin, dist = self:GetNearestCoin()
            if coin then
                if dist > 150 then
                    root.CFrame = coin.CFrame
                else
                    self:TweenTo(coin.CFrame, dist)

                    repeat task.wait()
                    until not coin:FindFirstChild("TouchInterest")
                    or not self.RoundActive
                    or self.BagFull
                    or self.Respawning
                    or self.DiedThisRound

                    self:CancelTween()
                end
            else
                task.wait(0.3)
            end
        end
    end)
end

