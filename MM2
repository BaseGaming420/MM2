local CONFIG_FILE = "mm2_autofarm_config.json"

local function loadConfig()
    local d={Enabled=true,ResetOnBagFull=true,Speed=26,AntiAFK=true,AutoRejoin=true,Rendering=false,MaxFPS=20}
    if not isfile or not isfile(CONFIG_FILE) then return d end
    local ok,data=pcall(function()return HttpService:JSONDecode(readfile(CONFIG_FILE))end)
    if not ok or type(data)~="table" then return d end
    for k,v in pairs(d) do if data[k]==nil then data[k]=v end end
    return data
end

local function saveConfig(t)
    if writefile then
        local ok,e=pcall(function()return HttpService:JSONEncode(t)end)
        if ok then writefile(CONFIG_FILE,e) end
    end
end

local Settings=loadConfig()

local SETTINGS_SYNC_FILE="mm2_settings_sync.json"
if not isfile(SETTINGS_SYNC_FILE) then writefile(SETTINGS_SYNC_FILE,HttpService:JSONEncode(Settings)) end

local function readGlobalSettings()
    local ok,data=pcall(function()return HttpService:JSONDecode(readfile(SETTINGS_SYNC_FILE))end)
    return ok and data or Settings
end

local function writeGlobalSettings()
    writefile(SETTINGS_SYNC_FILE,HttpService:JSONEncode(Settings))
end

local function applyGlobalSettings()
    local g=readGlobalSettings()
    for k,v in pairs(g) do Settings[k]=v end
    RunService:Set3dRenderingEnabled(Settings.Rendering)
    if setfpscap then setfpscap(Settings.MaxFPS) end
end

local SYNC_FILE="mm2_sync.json"
if not isfile(SYNC_FILE) then writefile(SYNC_FILE,"{}") end

local function readSync()
    local ok,data=pcall(function()return HttpService:JSONDecode(readfile(SYNC_FILE))end)
    return ok and data or {}
end

local function writeSync(d)
    writefile(SYNC_FILE,HttpService:JSONEncode(d))
end

local function markPresent()
    local d=readSync()
    d[Player.Name]=d[Player.Name]or{}
    d[Player.Name].present=true
    d[Player.Name].bagFull=false
    writeSync(d)
end

local function updateBagStatus(b)
    local d=readSync()
    d[Player.Name]=d[Player.Name]or{}
    d[Player.Name].present=true
    d[Player.Name].bagFull=b
    writeSync(d)
end

local function allAccountsFull()
    local d=readSync()
    local any=false
    for _,i in pairs(d) do
        if i.present then
            any=true
            if not i.bagFull then return false end
        end
    end
    return any
end

