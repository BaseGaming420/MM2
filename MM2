local CONFIG_FILE = "mm2_autofarm_config.json"

local function loadConfig()
    local default = {
        Enabled = true,
        ResetOnBagFull = true,
        Speed = 26,
        AntiAFK = true,
        AutoRejoin = true,
        Rendering = false,
        MaxFPS = 20
    }

    if not isfile or not isfile(CONFIG_FILE) then
        return default
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)

    if not ok or type(data) ~= "table" then
        return default
    end

    for k, v in pairs(default) do
        if data[k] == nil then
            data[k] = v
        end
    end

    return data
end

local function saveConfig(tbl)
    if writefile then
        local ok, encoded = pcall(function()
            return HttpService:JSONEncode(tbl)
        end)
        if ok then
            writefile(CONFIG_FILE, encoded)
        end
    end
end

local Settings = loadConfig()

--========================--
--   GLOBAL SETTINGS SYNC --
--========================--

local SETTINGS_SYNC_FILE = "mm2_settings_sync.json"

if not isfile(SETTINGS_SYNC_FILE) then
    writefile(SETTINGS_SYNC_FILE, HttpService:JSONEncode(Settings))
end

local function readGlobalSettings()
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(SETTINGS_SYNC_FILE))
    end)
    return ok and data or Settings
end

local function writeGlobalSettings()
    writefile(SETTINGS_SYNC_FILE, HttpService:JSONEncode(Settings))
end

local function applyGlobalSettings()
    local global = readGlobalSettings()
    for k, v in pairs(global) do
        Settings[k] = v
    end

    game:GetService("RunService"):Set3dRenderingEnabled(Settings.Rendering)
    if setfpscap then setfpscap(Settings.MaxFPS) end
end

--========================--
--   MULTI-ACCOUNT SYNC   --
--========================--

local SYNC_FILE = "mm2_sync.json"

if not isfile(SYNC_FILE) then
    writefile(SYNC_FILE, "{}")
end

local function readSync()
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(SYNC_FILE))
    end)
    return ok and data or {}
end

local function writeSync(data)
    writefile(SYNC_FILE, HttpService:JSONEncode(data))
end

local function markPresent()
    local data = readSync()
    data[Player.Name] = data[Player.Name] or {}
    data[Player.Name].present = true
    data[Player.Name].bagFull = false
    writeSync(data)
end

local function updateBagStatus(isFull)
    local data = readSync()
    data[Player.Name] = data[Player.Name] or {}
    data[Player.Name].present = true
    data[Player.Name].bagFull = isFull
    writeSync(data)
end

local function allAccountsFull()
    local data = readSync()
    local anyPresent = false

    for _, info in pairs(data) do
        if info.present then
            anyPresent = true
            if not info.bagFull then
                return false
            end
        end
    end

    return anyPresent
end

markPresent()

