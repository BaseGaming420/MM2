    function UI:Toggle(name,default,cb)
        local b=Instance.new("TextButton")
        b.Size=UDim2.new(1,0,0,32)
        b.BackgroundColor3=Color3.fromRGB(45,45,45)
        b.TextColor3=Color3.fromRGB(255,255,255)
        b.Text=name..": "..(default and"ON"or"OFF")
        b.Font=Enum.Font.Gotham
        b.TextSize=14
        b.Parent=s
        Instance.new("UICorner",b).CornerRadius=UDim.new(0,8)
        b.MouseButton1Click:Connect(function()
            default=not default
            b.Text=name..": "..(default and"ON"or"OFF")
            cb(default)
            saveConfig(Settings)
            writeGlobalSettings()
        end)
        return b
    end

    function UI:Slider(name,min,max,default,cb)
        local h=Instance.new("Frame")
        h.Size=UDim2.new(1,0,0,40)
        h.BackgroundTransparency=1
        h.Parent=s

        local l2=Instance.new("TextLabel")
        l2.Size=UDim2.new(1,0,0,18)
        l2.BackgroundTransparency=1
        l2.Text=name..": "..default
        l2.TextColor3=Color3.fromRGB(255,255,255)
        l2.Font=Enum.Font.Gotham
        l2.TextSize=14
        l2.Parent=h

        local bar=Instance.new("Frame")
        bar.Size=UDim2.new(1,0,0,14)
        bar.Position=UDim2.new(0,0,0,22)
        bar.BackgroundColor3=Color3.fromRGB(50,50,50)
        bar.Parent=h
        Instance.new("UICorner",bar).CornerRadius=UDim.new(0,6)

        local fill=Instance.new("Frame")
        fill.Size=UDim2.new((default-min)/(max-min),0,1,0)
        fill.BackgroundColor3=Color3.fromRGB(255,80,80)
        fill.Parent=bar
        Instance.new("UICorner",fill).CornerRadius=UDim.new(0,6)

        local dragging=false

        bar.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end
        end)

        UIS.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
        end)

        RunService.RenderStepped:Connect(function()
            if dragging then
                local m=UIS:GetMouseLocation().X
                local pos=math.clamp(m-bar.AbsolutePosition.X,0,bar.AbsoluteSize.X)
                local val=math.floor(min+(pos/bar.AbsoluteSize.X)*(max-min))
                fill.Size=UDim2.new(pos/bar.AbsoluteSize.X,0,1,0)
                l2.Text=name..": "..val
                cb(val)
                saveConfig(Settings)
                writeGlobalSettings()
            end
        end)

        return l2
    end

    return UI
end

